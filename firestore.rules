rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOwner(resource) {
      return isAuthenticated() && request.auth.uid == resource.data.owner;
    }

    function isShared(resource) {
      return isAuthenticated() &&
        resource.data.share is list &&
        request.auth.uid in resource.data.share;
    }

    function hasAccess(resource) {
      return isOwner(resource) || isShared(resource);
    }

    function creditsUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['credits']);
    }

    function apiKeysUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'openai_api_key',
        'anthropic_api_key',
        'google_gen_ai_api_key',
        'mistral_api_key',
        'fireworks_api_key'
      ]);
    }

    function noClientSecretsOnCreate() {
      return (!('credits' in request.resource.data) || request.resource.data.credits == 0)
        && (!('openai_api_key' in request.resource.data) || request.resource.data.openai_api_key == '')
        && (!('anthropic_api_key' in request.resource.data) || request.resource.data.anthropic_api_key == '')
        && (!('google_gen_ai_api_key' in request.resource.data) || request.resource.data.google_gen_ai_api_key == '')
        && (!('mistral_api_key' in request.resource.data) || request.resource.data.mistral_api_key == '')
        && (!('fireworks_api_key' in request.resource.data) || request.resource.data.fireworks_api_key == '');
    }

    function contentRevisionOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['content'])
        || (
          request.resource.data.revision is int
          && request.resource.data.revision == resource.data.get('revision', 0) + 1
        );
    }

    function ownerDocumentUpdateIsSafe() {
      return request.resource.data.owner == resource.data.owner
        && request.resource.data.share is list
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'content', 'updatedAt', 'share', 'revision']);
    }

    function sharedDocumentUpdateIsSafe() {
      return request.resource.data.owner == resource.data.owner
        && request.resource.data.share == resource.data.share
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'content', 'updatedAt', 'revision']);
    }

    match /users/{userId} {
      allow read: if isUser(userId);
      allow create: if isUser(userId) && noClientSecretsOnCreate();
      allow update: if isUser(userId) && creditsUntouched() && apiKeysUntouched();
      allow delete: if isUser(userId);

      match /profile/{docId} {
        allow read: if isUser(userId);
        allow create: if isUser(userId) && noClientSecretsOnCreate();
        allow update: if isUser(userId) && creditsUntouched() && apiKeysUntouched();
        allow delete: if false;
      }

      match /payments/{paymentId} {
        allow read: if isUser(userId);
        allow write: if false;
      }

      match /secrets/{docId} {
        allow read, write: if false;
      }

      match /private/{docId} {
        allow read, write: if false;
      }
    }

    match /docs/{documentId} {
      allow get: if isAuthenticated() && hasAccess(resource);
      allow list: if isAuthenticated() && hasAccess(resource);

      allow create: if isAuthenticated()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.share is list;

      allow update: if contentRevisionOk() && (
        (isOwner(resource) && ownerDocumentUpdateIsSafe())
        || (isShared(resource) && sharedDocumentUpdateIsSafe())
      );

      allow delete: if isAuthenticated()
        && resource.data.owner == request.auth.uid;
    }
  }
}
